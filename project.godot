; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="MadeInCpc"
run/main_scene="uid://ds3utitjvc4jj"
config/features=PackedStringArray("4.7", "Forward Plus")
boot_splash/bg_color=Color(1, 1, 1, 1)
boot_splash/stretch_mode=4
boot_splash/image="uid://crl41uwihdatm"
config/icon="res://icon.svg"
boot_splash/minimum_display_time=1000
boot_splash+/scene_loader/use_as_main_scene=true
boot_splash+/background/color=Color(0.97, 0.97, 0.97, 1)
boot_splash+/logo/image="uid://crl41uwihdatm"

[audio]

buses/default_bus_layout="uid://bsnsymhfipgcx"
default_bus_layout="res://addons/audiomanager/default_bus_layout.tres"

[autoload]

AudioManager="*uid://bgvuyv285gsbx"
PhantomCameraManager="*uid://duq6jhf6unyis"
GameManager="*uid://d18nvdiy1l0oy"
SceneManager="*uid://j20v4cg7v8m1"

[display]

window/stretch/mode="canvas_items"

[editor_plugins]

enabled=PackedStringArray("res://addons/AudioManager/plugin.cfg", "res://addons/custom_resource_previews/plugin.cfg", "res://addons/madeincmp/plugin.cfg", "res://addons/phantom_camera/plugin.cfg", "res://addons/scene_manager/plugin.cfg")

[file_customization]

folder_colors={
"res://addons/": "gray",
"res://description/": "pink",
"res://mini_games/": "green",
"res://script_templates/": "gray",
"res://template/": "gray",
"res://titlemenu/": "gray"
}

[gui]

theme/custom_font="uid://dx34p7d5owvl7"

