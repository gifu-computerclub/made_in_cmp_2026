; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="MadeInCpc"
run/main_scene="uid://ds3utitjvc4jj"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"

[audio]

buses/default_bus_layout="uid://bsnsymhfipgcx"
default_bus_layout="res://addons/audiomanager/default_bus_layout.tres"

[autoload]

AudioManager="*uid://bgvuyv285gsbx"
PhantomCameraManager="*uid://duq6jhf6unyis"
SceneManager="*uid://j20v4cg7v8m1"
GameManager="*uid://d18nvdiy1l0oy"

[display]

window/stretch/mode="canvas_items"

[editor_plugins]

enabled=PackedStringArray("res://addons/AudioManager/plugin.cfg", "res://addons/phantom_camera/plugin.cfg", "res://addons/scene_manager/plugin.cfg")

[file_customization]

folder_colors={
"res://addons/": "gray",
"res://description/": "pink",
"res://mini_game/": "green",
"res://script_templates/": "gray",
"res://template/": "gray",
"res://titlemenu/": "gray"
}

